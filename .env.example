# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform browser key.
VITE_GOOGLE_MAPS_API_KEY=""

# LEAD_RECEIVER_EMAIL: Destination inbox for student inquiries and assessments.
LEAD_RECEIVER_EMAIL="88smusman@gmail.com"

# Gmail SMTP credentials for automated lead emails to 88smusman@gmail.com
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Meta Graph API credentials for live Facebook & Instagram auto-sync
META_ACCESS_TOKEN=""
FB_PAGE_ID=""
IG_USER_ID=""

